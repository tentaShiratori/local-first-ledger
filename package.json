{
  "name": "local-first-ledger",
  "version": "0.0.0",
  "private": true,
  "description": "家族共有のオフライン家計簿を作りながら CRDT を学ぶ学習用リポジトリ",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "lint": "vp lint --deny-warnings",
    "fmt": "vp fmt --check",
    "fmt:write": "vp fmt --write",
    "deadcode": "fallow dead-code",
    "test": "vp test",
    "test:coverage": "vp test run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt && pnpm deadcode && pnpm test:coverage && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "catalog:",
    "fallow": "3.41.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.20.0 || ^24.0.0 || >=26.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.4"
}
