{
  "name": "local-first-ledger",
  "version": "0.4.0",
  "private": true,
  "description": "家族共有のオフライン家計簿を作りながら CRDT を学ぶ学習用リポジトリ",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:lib": "tsc -p tsconfig.build.json",
    "build:app": "vp build",
    "build": "pnpm build:lib && pnpm build:app",
    "dev": "vp dev",
    "preview": "vp preview --host 127.0.0.1 --port 4173 --strictPort",
    "relay": "pnpm build:lib && node dist/relay/cli.js",
    "lint": "vp lint --deny-warnings",
    "fmt": "vp fmt --check",
    "fmt:write": "vp fmt --write",
    "deadcode": "fallow dead-code",
    "test": "vp test",
    "test:coverage": "vp test run --coverage",
    "e2e": "pnpm build:app && E2E_TELEMETRY_DISABLED=1 e2e run",
    "verify:offline-tabs": "pnpm build:app && node scripts/verify-offline-and-tabs.mjs",
    "verify:relay-sync": "pnpm build && node scripts/verify-relay-sync.mjs",
    "verify:conflict-fields": "pnpm build && node scripts/verify-conflict-fields.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt && pnpm deadcode && pnpm test:coverage && pnpm build"
  },
  "dependencies": {
    "ws": "^8.22.2",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@e2e-dev/web": "^0.15.5",
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "catalog:",
    "e2e": "^0.23.0",
    "fake-indexeddb": "^6.2.8",
    "fallow": "3.41.0",
    "playwright-core": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.20.0 || ^24.0.0 || >=26.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.4"
}
